<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The audit feed is transient; an advisory published mid-build must not fail it. -->
    <WarningsNotAsErrors>NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'"
      >true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Tralys.Ui contributors</Authors>
    <Company>Tralys</Company>
    <Product>Tralys.Ui</Product>
    <Copyright>Copyright (c) Tralys.Ui contributors</Copyright>
    <VersionPrefix>0.1.0</VersionPrefix>
    <IsPackable>false</IsPackable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tralys/Tralys.Ui</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tralys/Tralys.Ui</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ui;components;mvvm;bgfx;game-ui;gamedev;zero-allocation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt;PublicAPI.Unshipped.txt" />
    <None
      Include="$(MSBuildThisFileDirectory)README.md"
      Pack="true"
      PackagePath="/"
      Visible="false"
    />
    <None
      Include="$(MSBuildThisFileDirectory)LICENSE"
      Pack="true"
      PackagePath="/"
      Visible="false"
    />
    <None
      Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md"
      Pack="true"
      PackagePath="/"
      Visible="false"
    />
  </ItemGroup>

  <!-- NuGet has no exact-version ProjectReference; ExactVersion="true" packs one as [its version]. -->
  <Target Name="PinExactProjectReferenceVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ExactProjectReference
        Include="@(ProjectReference->'%(FullPath)')"
        Condition="'%(ProjectReference.ExactVersion)' == 'true'"
      />
      <_LooseProjectReferenceVersion
        Include="@(_ProjectReferencesWithVersions)"
        Exclude="@(_ExactProjectReference)"
      />
      <_ExactProjectReferenceVersion
        Include="@(_ProjectReferencesWithVersions)"
        Exclude="@(_LooseProjectReferenceVersion)"
      />
      <_ExactProjectReferenceVersion>
        <ProjectVersion>[%(ProjectVersion)]</ProjectVersion>
      </_ExactProjectReferenceVersion>
      <_ProjectReferencesWithVersions Remove="@(_ExactProjectReferenceVersion)" />
      <_ProjectReferencesWithVersions Include="@(_ExactProjectReferenceVersion)" />
    </ItemGroup>
  </Target>
</Project>
