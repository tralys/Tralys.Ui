<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <Description>The Tralys.Ui font backend on FreeType, with FreeType's native library for Android as runtime assets.</Description>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAndroidFreeType</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FreeTypeSharp" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Tralys.Ui.Engine/Tralys.Ui.Engine.csproj" />
    <ProjectReference
      Include="../Tralys.Ui.Analyzers/Tralys.Ui.Analyzers.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
    />
  </ItemGroup>

  <!-- FreeTypeSharp ships Android's library only inside an AAR, which a NativeAOT publish never unpacks. -->
  <ItemGroup>
    <TralysAndroidAbi Include="arm64-v8a" Rid="android-arm64" />
    <TralysAndroidAbi Include="x86_64" Rid="android-x64" />
  </ItemGroup>

  <Target Name="PackAndroidFreeType">
    <ItemGroup>
      <_TralysFreeTypeAar Include="$(PkgFreeTypeSharp)/lib/*android*/FreeTypeSharp.aar" />
    </ItemGroup>
    <PropertyGroup>
      <_TralysFreeTypeAarDir>$(IntermediateOutputPath)freetype-aar/</_TralysFreeTypeAarDir>
    </PropertyGroup>
    <Error
      Condition="'@(_TralysFreeTypeAar)' == ''"
      Text="FreeTypeSharp $(PkgFreeTypeSharp) has no Android AAR to take libfreetype.so from."
    />
    <Unzip SourceFiles="@(_TralysFreeTypeAar)" DestinationFolder="$(_TralysFreeTypeAarDir)" />
    <Error
      Condition="!Exists('$(_TralysFreeTypeAarDir)jni/%(TralysAndroidAbi.Identity)/libfreetype.so')"
      Text="The FreeTypeSharp AAR has no %(TralysAndroidAbi.Identity) libfreetype.so."
    />
    <ItemGroup>
      <TfmSpecificPackageFile
        Include="$(_TralysFreeTypeAarDir)jni/%(TralysAndroidAbi.Identity)/libfreetype.so"
        PackagePath="runtimes/%(TralysAndroidAbi.Rid)/native"
      />
    </ItemGroup>
  </Target>
</Project>
