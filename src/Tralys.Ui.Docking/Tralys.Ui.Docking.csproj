<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <Description>Docking for Tralys.Ui: panels in tab groups that split, float, tear out into windows of their own and dock back, with a layout that saves and loads.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- None private: a package consumer of this one alone still gets Tralys.Ui's generators and analyzers. -->
    <ProjectReference Include="../Tralys.Ui/Tralys.Ui.csproj" PrivateAssets="none" />
    <ProjectReference
      Include="../Tralys.Ui.Mvvm.Generators/Tralys.Ui.Mvvm.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
    />
    <ProjectReference
      Include="../Tralys.Ui.Analyzers/Tralys.Ui.Analyzers.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
    />
    <ProjectReference
      Include="../Tralys.Ui.Generators/Tralys.Ui.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
    />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tralys.Ui.Docking.Tests" />
  </ItemGroup>
</Project>
